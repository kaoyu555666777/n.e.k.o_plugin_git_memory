{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "N.E.K.O: check git_memory",
      "type": "shell",
      "command": "uv run neko-plugin check git_memory",
      "options": {
        "cwd": "${config:nekoPlugin.repoRoot}"
      },
      "problemMatcher": []
    },
    {
      "label": "N.E.K.O: sync git_memory",
      "type": "shell",
      "command": "uv run --with pip neko-plugin sync git_memory --clean",
      "options": {
        "cwd": "${config:nekoPlugin.repoRoot}"
      },
      "problemMatcher": []
    },
    {
      "label": "N.E.K.O: check -r git_memory",
      "type": "shell",
      "command": "uv run neko-plugin check -r git_memory",
      "options": {
        "cwd": "${config:nekoPlugin.repoRoot}"
      },
      "problemMatcher": []
    },
    {
      "label": "N.E.K.O: build git_memory",
      "type": "shell",
      "command": "uv run neko-plugin build git_memory",
      "options": {
        "cwd": "${config:nekoPlugin.repoRoot}"
      },
      "problemMatcher": []
    }
  ]
}
